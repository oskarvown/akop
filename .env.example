# «Дебиторка-бот» — переменные окружения (Stage 1)
# Реальные значения предоставляются перед деплоем (Stage 7).
# Плейсхолдеры описаны в docs/ASSUMPTIONS.md §4.

# Telegram
BOT_TOKEN=changeme
ALLOWED_USER_ID=0

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=debitor_bot
DB_USER=debitor_bot
DB_PASSWORD=changeme

# Недельный цикл (Stage 3) — не хардкодить в коде
AUDIT_IDLE_TIMEOUT_SECONDS=3600

# LLM fallback для неоднозначных комментариев (Roadmap §6.1, Stage 6, провайдер не выбран)
LLM_API_KEY=
LLM_MODEL=
