# «Дебиторка-бот» — переменные окружения (Stage 1 + Stage 3.2)
# Реальные значения предоставляются перед деплоем (Stage 7).
# Плейсхолдеры описаны в docs/ASSUMPTIONS.md §4.

# Telegram
BOT_TOKEN=changeme
# Один или несколько Telegram user_id через запятую
ALLOWED_USER_IDS=0

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=debitor_bot
DB_USER=debitor_bot
DB_PASSWORD=changeme

# Недельный цикл / idle reminders (Stage 3.2) — production defaults
AUDIT_IDLE_TIMEOUT_SECONDS=86400
AUDIT_REMINDER_INTERVAL_SECONDS=86400
AUDIT_MAX_REMINDERS=2
AUDIT_EXPIRE_GRACE_SECONDS=86400
AUDIT_NOTIFICATION_CHAT_ID=743971617
AUDIT_SCHEDULER_POLL_SECONDS=60
AUDIT_REMINDER_CLAIM_TTL_SECONDS=300
AUDIT_REMINDER_SEND_TIMEOUT_SECONDS=30
AUDIT_REMINDER_ERROR_BACKOFF_SECONDS=900

# Stage 4.1 report build (Excel itself is Stage 4.2)
REPORT_BUILD_CLAIM_TTL_SECONDS=300
REPORT_BUILD_MAX_ATTEMPTS=5
REPORT_BUILD_BACKOFF_SECONDS=60
REPORT_SCHEDULER_POLL_SECONDS=30

# Stage 4.3 Telegram report delivery
REPORT_DELIVERY_CLAIM_TTL_SECONDS=300
REPORT_DELIVERY_SEND_TIMEOUT_SECONDS=30
REPORT_DELIVERY_MAX_ATTEMPTS=5
REPORT_DELIVERY_BACKOFF_SECONDS=60
REPORT_DELIVERY_MAX_FILE_BYTES=52428800
REPORT_DELIVERY_BATCH_SIZE=10

# Stage 4.4 OpenRouter comment enrichment (ENRICHED Excel)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=2
COMMENT_ENRICHMENT_CLAIM_TTL_SECONDS=600
COMMENT_ENRICHMENT_RUN_TIMEOUT_SECONDS=300
COMMENT_ENRICHMENT_MAX_ATTEMPTS=5
COMMENT_ENRICHMENT_BACKOFF_SECONDS=60
COMMENT_ENRICHMENT_BATCH_SIZE=10
COMMENT_PARSER_VERSION=1
COMMENT_PROMPT_VERSION=1
COMMENT_SCHEMA_VERSION_LLM=1
COMMENT_REDACTION_VERSION=1

# Legacy aliases (optional; mapped to OPENROUTER_* if those are empty)
LLM_API_KEY=
LLM_MODEL=
